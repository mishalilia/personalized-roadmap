{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "dom",
      "es2022"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "esModuleInterop": true,
    "baseUrl": ".",
    "typeRoots": [
      "../site/node_modules/@types"
    ],
    "paths": {
      "@pp/*": [
        "../site/src/components/personal-path/*"
      ],
      "@docusaurus/*": [
        "../site/node_modules/@docusaurus/*"
      ],
      "react": [
        "../site/node_modules/@types/react"
      ],
      "react/*": [
        "../site/node_modules/@types/react/*"
      ],
      "react-dom": [
        "../site/node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "../site/node_modules/@types/react-dom/*"
      ],
      "*": [
        "../site/node_modules/*",
        "../site/node_modules/@types/*"
      ]
    }
  },
  "files": [
    "src/main.tsx",
    "src/Designer.tsx",
    "src/theme.ts",
    "src/css.d.ts"
  ]
}
