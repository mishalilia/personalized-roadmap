# Caddy gets and renews HTTPS certificates for both names by itself; their DNS records must point here.
{$SITE_DOMAIN} {
	encode gzip
	reverse_proxy site:80
}

{$API_DOMAIN} {
	# Not the planned path, which arrives module by module as server-sent events: compressed, it could be held
	# back until the end.
	@compressed not path /path/stream
	encode @compressed gzip
	# Project archives are at most 20 MB; the API refuses larger ones too.
	request_body {
		max_size 21MB
	}
	reverse_proxy api:8000
}
