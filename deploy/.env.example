# Copy to deploy/.env and fill in. Never commit the filled file: it holds keys.

# Two DNS names pointing at this server: the curriculum site and the API. Keep them under one domain, as here:
# the session cookie is sent only between pages of the same site.
SITE_DOMAIN=path.example.com
API_DOMAIN=api.path.example.com

# The curriculum repository with the personal path page, checked out on this server, relative to deploy/.
SITE_DIR=../../int.academy-curriculum

# The database's password; only the API uses it, inside this server. Long and random, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# Model keys (at least one; see config/llm.yaml). Without any, paths follow the course as written.
LLM_API_KEY_OPENAI=
LLM_API_KEY_GOOGLE=
LLM_API_KEY_GROQ=

# Opens GET /report (where learners who share their progress stop). Long and random, e.g. `openssl rand -hex 32`.
API_REPORT_TOKEN=

# Optional: sign-in with Google. Create an OAuth client in Google Cloud Console (APIs & Services → Credentials →
# OAuth client ID, type "Web application") with https://<API_DOMAIN>/auth/google/callback as an authorized redirect
# URI. Without both values, learners sign in with an email and a password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may change the AI reviewer's decisions on submitted capstone projects, comma-separated emails; they sign up
# on the site as usual. Optional GITHUB_TOKEN: reviews then read more than 60 public repositories an hour.
GITHUB_TOKEN=
API_REVIEWER_EMAILS=

# Model calls per learner (by IP address) an hour.
API_RATE_LIMIT=20

# HumbleBeeAI's chat widget endpoint, if the site should keep it; empty uses the site's default.
REACT_APP_CHAT_LINK=

# Where coding problems load Python (Pyodide) in the learner's browser; empty uses the jsDelivr CDN.
PYODIDE_URL=
