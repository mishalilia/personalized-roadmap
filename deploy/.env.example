# Copy to deploy/.env and fill in. Never commit the filled file: it holds keys.

# Two DNS names pointing at this server: the curriculum site and the API.
SITE_DOMAIN=path.example.com
API_DOMAIN=api.path.example.com

# The curriculum repository with the personal path page, checked out on this server, relative to deploy/.
SITE_DIR=../../int.academy-curriculum

# Model keys (at least one; see config/llm.yaml). Without any, paths follow the course as written.
LLM_API_KEY_GOOGLE=
LLM_API_KEY_GROQ=

# Opens GET /report (where learners who share their progress stop). Long and random, e.g. `openssl rand -hex 32`.
API_REPORT_TOKEN=

# Model calls per learner (by IP address) an hour.
API_RATE_LIMIT=20

# HumbleBeeAI's chat widget endpoint, if the site should keep it; empty uses the site's default.
REACT_APP_CHAT_LINK=

# Where coding problems load Python (Pyodide) in the learner's browser; empty uses the jsDelivr CDN.
PYODIDE_URL=
