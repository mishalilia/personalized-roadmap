# Copy to .env and fill in. Never commit the filled file.
# Without a key the app still runs, but paths follow the course as written.

# Keys for the providers in config/llm.yaml (provider chosen in Q-003)
LLM_API_KEY_GROQ=
LLM_API_KEY_GOOGLE=

# Optional: which provider to use (groq or google); without it, the first one in config/llm.yaml with a key
LLM_PROVIDER=
