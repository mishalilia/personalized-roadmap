# Copy to .env and fill in. Never commit the filled file.
# Without a key everything still runs, but paths follow the course as written.

# Keys for the providers in config/llm.yaml (OpenAI is the default; Google and Groq have free tiers)
LLM_API_KEY_OPENAI=
LLM_API_KEY_GOOGLE=
LLM_API_KEY_GROQ=

# Optional: which provider to ask first (openai, google or groq). Every provider with a key is asked in the order of
# config/llm.yaml until one answers
LLM_PROVIDER=

# Optional, for the HTTP API (src/roadmap/api.py); deploy/.env.example sets them on a server.
# Sites that may call it, comma-separated (default http://localhost:3000)
API_ALLOWED_ORIGINS=
# Model calls per client per window, and the window in seconds (defaults 20 and 3600)
API_RATE_LIMIT=
API_RATE_WINDOW=
# Opens GET /report; no report without it
API_REPORT_TOKEN=
# Where shared progress is kept (default data/events.sqlite)
API_EVENTS_FILE=
# Accounts that may review submitted capstone projects, comma-separated emails (the site's /review page)
API_REVIEWER_EMAILS=
# Optional: a GitHub token, so reviews can read more than 60 public repositories an hour
GITHUB_TOKEN=
# Where archives of submitted projects are kept (default data/uploads)
API_UPLOADS_DIR=
# Where accounts and their paths are kept (default data/accounts.sqlite)
API_ACCOUNTS_FILE=
# The session cookie goes over HTTPS only; set false to try the API over plain http://localhost
API_COOKIE_SECURE=
# The API's address as browsers reach it (default http://localhost:8000); Google returns learners to it
API_PUBLIC_URL=

# Optional: sign-in with Google. Create an OAuth client in Google Cloud Console (APIs & Services → Credentials →
# OAuth client ID, type "Web application") with <API_PUBLIC_URL>/auth/google/callback as an authorized redirect
# URI. Without both values, learners sign in with an email and a password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
