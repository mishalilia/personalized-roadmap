# Copy to .env and fill in. Never commit the filled file.
# Without a key everything still runs, but paths follow the course as written.

# Keys for the providers in config/llm.yaml
LLM_API_KEY_OPENAI=
LLM_API_KEY_GROQ=
LLM_API_KEY_GOOGLE=

# Optional: which provider to use (openai, google or groq); without it, the first one in config/llm.yaml with a key
LLM_PROVIDER=

# Optional, for the HTTP API (src/roadmap/api.py); deploy/.env.example sets them on a server.
# Sites that may call it, comma-separated (default http://localhost:3000)
API_ALLOWED_ORIGINS=
# Model calls per client per window, and the window in seconds (defaults 20 and 3600)
API_RATE_LIMIT=
API_RATE_WINDOW=
# Opens GET /report; no report without it
API_REPORT_TOKEN=
# Where shared progress is kept (default data/events.sqlite)
API_EVENTS_FILE=
